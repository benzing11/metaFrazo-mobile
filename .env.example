# MetaFrazo environment (copy to .env and fill)

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_NODE_IP=127.0.0.1

# Backend
BACKEND_PORT=3000
BACKEND_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/metafrazo.db
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# AI service
AI_SERVICE_PORT=8000
AI_SERVICE_BASE_URL=http://localhost:8000
WHISPER_MODEL=base
INDICTRANS_MODEL=
TESSERACT_LANGS=tam+eng,hin

# Storage (recordings)
RECORDINGS_DIR=./data/recordings
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Android (local.properties / build config)
ANDROID_BACKEND_URL=http://10.0.2.2:3000
ANDROID_AI_SERVICE_URL=http://10.0.2.2:8000

# Dev auth bypass (NEVER in production)
DEV_AUTH_BYPASS=true
NODE_ENV=development