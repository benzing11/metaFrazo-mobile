<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: allow cleartext so a physical phone can reach the dev backend on the LAN (e.g. http://192.168.x.x:3000). Release keeps the HTTPS-only main config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
